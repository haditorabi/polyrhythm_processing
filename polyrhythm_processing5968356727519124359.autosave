NoteSpiral spiral;
GradientBackground gradient;

void setup() {
  size(1200, 800);
  background(0);
  noStroke();
  colorMode(HSB, 360, 100, 100, 100);
  gradient = new GradientBackground(color(190, 100, 100), color(310, 100, 50), 
                                    color(190, 100, 100), color(310, 100, 100));
  spiral = new NoteSpiral();
}

void draw() {
  background(0);
  //gradient.drawBackground();
  spiral.updateAndDraw();
}
